FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

WORKDIR /app

COPY requirements-growth-test-agent.txt .
RUN pip install --no-cache-dir -r requirements-growth-test-agent.txt

COPY iat/growth_test_agent.py ./growth_test_agent.py

EXPOSE 10000

CMD ["sh", "-c", "uvicorn growth_test_agent:app --host 0.0.0.0 --port ${PORT:-10000}"]
