FROM python:3.12-slim

WORKDIR /app
COPY requirements.txt pyproject.toml README.md ./
COPY iat ./iat
RUN pip install --no-cache-dir .

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Render reserves port 10000 from private-network traffic. The signer must use
# a different port so the public API can reach it over the internal hostname.
CMD ["uvicorn", "iat.quote_signer_service:app", "--host", "0.0.0.0", "--port", "10001"]
